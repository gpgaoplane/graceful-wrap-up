#!/usr/bin/env bash
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/handoff-lib.sh"

# Read stdin JSON; extract session_id
INPUT=$(cat)
SID=$(printf '%s' "$INPUT" | grep -o '"session_id":"[^"]*"' | cut -d'"' -f4)
export SESSION_ID="${SID:-unknown}"

# Increment counter
COUNT=$(get_and_increment_call_count)

# Re-block immediately if signal already STOP or EMERGENCY
EXISTING_TIER=$(read_signal_tier)
if [[ "$EXISTING_TIER" == "STOP" || "$EXISTING_TIER" == "EMERGENCY" ]]; then
    emit_context_injection "HANDOFF_SIGNAL: BLOCKED — session quota limit reached. Do not use any more tools. Write AI_HANDOFF.md (include: git log --oneline -20, open tasks, blocking issues, key context) and RESUME_PROMPT.md (continuation instructions for next session). Then output 'SESSION ENDING' and stop."
    exit 2
fi

# Skip quota check on non-10th calls — UNLESS any signal already exists (accelerated polling)
if ! should_check_this_call "$COUNT"; then
    [[ -z "$EXISTING_TIER" ]] && exit 0
fi

# --- Five-hour quota check (cascade: oauth → jsonl → heuristic) ---
QUOTA_SOURCE="none"
PCT=$(get_quota "$COUNT")
TIER=""
[[ -n "$PCT" ]] && TIER=$(tier_from_pct "$PCT")

# --- Weekly quota check (oauth only — no heuristic fallback) ---
# get_weekly_quota_oauth outputs "PCT|RESETS_AT"; parse both fields here
# to avoid subshell isolation losing WEEKLY_RESETS_AT
WEEKLY_RESULT=$(get_weekly_quota_oauth 2>/dev/null || echo "")
WEEKLY_PCT="${WEEKLY_RESULT%%|*}"
WEEKLY_RESETS_AT="${WEEKLY_RESULT##*|}"
[[ "$WEEKLY_PCT" == "$WEEKLY_RESETS_AT" ]] && WEEKLY_RESETS_AT=""  # no | separator = no resets_at
WEEKLY_TIER=""
[[ -n "$WEEKLY_PCT" && "$WEEKLY_PCT" =~ ^[0-9]+$ ]] && WEEKLY_TIER=$(tier_from_weekly_pct "$WEEKLY_PCT")

# Pick the more severe tier; weekly wins on tie-break when equal severity
FIVEHR_SEV=$(tier_severity "$TIER")
WEEKLY_SEV=$(tier_severity "$WEEKLY_TIER")

ACTIVE_SOURCE="$QUOTA_SOURCE"
if (( WEEKLY_SEV >= FIVEHR_SEV && WEEKLY_SEV > 0 )); then
    TIER="$WEEKLY_TIER"
    PCT="$WEEKLY_PCT"
    ACTIVE_SOURCE="seven_day"
fi

[[ -z "$TIER" ]] && exit 0

write_signal_file "$TIER" "$PCT" "$ACTIVE_SOURCE"

# Format reset date for weekly messages (shorten ISO timestamp to date only)
weekly_reset_date() {
    printf '%s' "${WEEKLY_RESETS_AT%%T*}"
}

case "$TIER" in
    WARN)
        if [[ "$ACTIVE_SOURCE" == "seven_day" ]]; then
            emit_context_injection "HANDOFF_SIGNAL: WEEKLY quota at ${PCT}% (WARN) — resets $(weekly_reset_date). Estimate token cost before starting large tasks; avoid multi-step operations."
        else
            emit_context_injection "HANDOFF_SIGNAL: 5-hour quota at ${PCT}% (WARN). Estimate token cost before starting large tasks; prefer smaller focused operations."
        fi
        exit 0
        ;;
    PREPARE)
        emit_context_injection "HANDOFF_SIGNAL: quota at ${PCT}% (PREPARE). Finish current task step, then: (1) write AI_HANDOFF.md — include git log --oneline -20, open tasks, blocking issues; (2) write RESUME_PROMPT.md with continuation instructions; (3) start a new session."
        exit 0
        ;;
    STOP)
        emit_context_injection "HANDOFF_SIGNAL: STOP — quota at ${PCT}%. Do not start new tasks. Immediately: (1) write AI_HANDOFF.md (git log --oneline -20, open tasks, context); (2) write RESUME_PROMPT.md; (3) output 'SESSION ENDING — quota limit' and stop."
        exit 2
        ;;
    EMERGENCY)
        if [[ "$ACTIVE_SOURCE" == "seven_day" ]]; then
            emit_context_injection "HANDOFF_SIGNAL: EMERGENCY — WEEKLY quota at ${PCT}%. Weekly limit reached; new sessions also blocked until $(weekly_reset_date). Write AI_HANDOFF.md and RESUME_PROMPT.md NOW, then stop."
        else
            emit_context_injection "HANDOFF_SIGNAL: EMERGENCY — quota at ${PCT}%. Write AI_HANDOFF.md (git log --oneline -20, open tasks, critical context) and RESUME_PROMPT.md immediately. Session must end NOW."
        fi
        exit 2
        ;;
esac

exit 0
