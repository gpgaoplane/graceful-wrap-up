#!/usr/bin/env bash
# PreCompact hook: context compaction = implicit PREPARE signal.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/handoff-lib.sh"

INPUT=$(cat)
SID=$(printf '%s' "$INPUT" | grep -o '"session_id":"[^"]*"' | cut -d'"' -f4)
export SESSION_ID="${SID:-unknown}"

EXISTING=$(read_signal_tier)
if (( $(tier_severity "$EXISTING") >= $(tier_severity "PREPARE") )); then
    exit 0
fi

write_signal_file "PREPARE" "90+" "compaction"
emit_system_message "HANDOFF_SIGNAL: context compaction triggered — tier=PREPARE. Consider wrapping up current work."
exit 0
