#!/usr/bin/env bash
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/handoff-lib.sh"

# Read stdin JSON; extract session_id
INPUT=$(cat)
SID=$(printf '%s' "$INPUT" | grep -o '"session_id":"[^"]*"' | cut -d'"' -f4)
export SESSION_ID="${SID:-unknown}"

discard_turn_state_if_session_mismatch "$SESSION_ID"
discard_turn_state_if_expired

TURN_OPEN=$(read_turn_state_field turn_open)
TURN_PERMISSION=$(read_turn_state_field turn_permission)
HAS_ACTIVE_APPROVAL=false
if [[ "$TURN_OPEN" == "true" && ( "$TURN_PERMISSION" == "finish-this" || "$TURN_PERMISSION" == "continue" ) ]]; then
    HAS_ACTIVE_APPROVAL=true
fi

# Increment counter
COUNT=$(get_and_increment_call_count)
EXISTING_TIER=$(read_signal_tier)

# Skip quota check on non-10th calls — UNLESS any signal already exists (accelerated polling)
if ! should_check_this_call "$COUNT"; then
    [[ "$HAS_ACTIVE_APPROVAL" == true ]] && exit 0
    [[ -z "$EXISTING_TIER" ]] && exit 0
fi

# --- Five-hour quota check (cascade: oauth → jsonl → heuristic) ---
QUOTA_RESULT=$(get_quota_state "$COUNT")
PCT="${QUOTA_RESULT%%|*}"
QUOTA_SOURCE="${QUOTA_RESULT##*|}"
[[ "$PCT" == "$QUOTA_SOURCE" ]] && QUOTA_SOURCE="none"
TIER=""
[[ -n "$PCT" ]] && TIER=$(tier_from_pct "$PCT")

# --- Weekly quota check (oauth only — no heuristic fallback) ---
# get_weekly_quota_oauth outputs "PCT|RESETS_AT"; parse both fields here
# to avoid subshell isolation losing WEEKLY_RESETS_AT
WEEKLY_RESULT=$(get_weekly_quota_oauth 2>/dev/null || echo "")
WEEKLY_PCT="${WEEKLY_RESULT%%|*}"
WEEKLY_RESETS_AT="${WEEKLY_RESULT##*|}"
[[ "$WEEKLY_PCT" == "$WEEKLY_RESETS_AT" ]] && WEEKLY_RESETS_AT=""  # no | separator = no resets_at
WEEKLY_TIER=""
[[ -n "$WEEKLY_PCT" && "$WEEKLY_PCT" =~ ^[0-9]+$ ]] && WEEKLY_TIER=$(tier_from_weekly_pct "$WEEKLY_PCT")

# Pick the more severe tier; weekly wins on tie-break when equal severity
FIVEHR_SEV=$(tier_severity "$TIER")
WEEKLY_SEV=$(tier_severity "$WEEKLY_TIER")

ACTIVE_SOURCE="$QUOTA_SOURCE"
if (( WEEKLY_SEV >= FIVEHR_SEV && WEEKLY_SEV > 0 )); then
    TIER="$WEEKLY_TIER"
    PCT="$WEEKLY_PCT"
    ACTIVE_SOURCE="seven_day"
fi

[[ -z "$TIER" ]] && exit 0

write_signal_file "$TIER" "$PCT" "$ACTIVE_SOURCE"

# Build " — resets YYYY-MM-DD" suffix only when WEEKLY_RESETS_AT is present.
weekly_reset_suffix() {
    local date_only="${WEEKLY_RESETS_AT%%T*}"
    [[ -n "$date_only" ]] && printf ' — resets %s' "$date_only"
}

case "$TIER" in
    WARN)
        if [[ "$ACTIVE_SOURCE" == "seven_day" ]]; then
            emit_context_injection "HANDOFF_SIGNAL: WEEKLY quota at ${PCT}% (WARN)$(weekly_reset_suffix). Session approaching the weekly limit. Type STOP_NOW at any time to start handoff."
        else
            emit_context_injection "HANDOFF_SIGNAL: 5-hour quota at ${PCT}% (WARN). Session approaching the limit. Type STOP_NOW at any time to start handoff."
        fi
        exit 0
        ;;
    PREPARE)
        emit_context_injection "HANDOFF_SIGNAL: quota at ${PCT}% (PREPARE). Before executing: break current planned work into steps, identify which steps can complete within remaining quota, present the breakdown to the user without executing, wait for confirmation. Type STOP_NOW at any time to start handoff."
        exit 0
        ;;
    STOP)
        emit_context_injection "HANDOFF_SIGNAL: quota at ${PCT}% (STOP). Complete the current request. Write handoff artifacts when done. Type STOP_NOW at any time to start handoff."
        exit 0
        ;;
esac

exit 0
